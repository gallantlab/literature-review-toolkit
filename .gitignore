# Docs site build output (generated by `mkdocs build`)
/site/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local review documents: pages built for a human to read once, kept beside the
# code but not part of it. Tracking them would also inflate the computed version,
# since version.py counts uncommitted work as the next commit.
/code_review_*.html
/playbook_to_code_*.html

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Project outputs (these are produced by users, not part of the toolkit)
papers/
*.xlsx
# ...except the real example outputs the docs link to
!docs/assets/examples/**/*.xlsx
xref_*.json
*_verify*.json
*_manifest.json
_download_helper.html
all_existing_dois.json
